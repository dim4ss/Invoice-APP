using System;
using System.Windows.Forms;
using MySql.Data.MySqlClient;
using BCrypt.Net;

namespace UKK_SPP
{
    public partial class FormRegisterPetugas : Form
    {
        public FormRegisterPetugas()
        {
            InitializeComponent();
            this.StartPosition = FormStartPosition.CenterScreen;
            
            // Set opsi ComboBox Level
            cmbLevel.Items.Clear();
            cmbLevel.Items.Add("petugas");
            cmbLevel.Items.Add("admin");
            cmbLevel.SelectedIndex = 0;

            txtPassword.UseSystemPasswordChar = true;
            txtKonfirmasiPassword.UseSystemPasswordChar = true;
        }

        private void btnSimpan_Click(object sender, EventArgs e)
        {
            // 2. Validasi input: seluruh field wajib terisi
            if (string.IsNullOrWhiteSpace(txtUsername.Text) || 
                string.IsNullOrWhiteSpace(txtNamaPetugas.Text) || 
                string.IsNullOrWhiteSpace(txtPassword.Text) || 
                string.IsNullOrWhiteSpace(txtKonfirmasiPassword.Text))
            {
                MessageBox.Show("Seluruh field wajib terisi!", "Peringatan", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }

            // Kata sandi minimal 6 karakter
            if (txtPassword.Text.Length < 6)
            {
                MessageBox.Show("Kata sandi minimal harus 6 karakter!", "Peringatan", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                txtPassword.Focus();
                return;
            }

            // Nilai pada txtPassword harus sama dengan txtKonfirmasiPassword
            if (txtPassword.Text != txtKonfirmasiPassword.Text)
            {
                MessageBox.Show("Konfirmasi kata sandi tidak cocok!", "Peringatan", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                txtKonfirmasiPassword.Focus();
                return;
            }

            using (MySqlConnection conn = Koneksi.GetConnection())
            {
                if (conn == null) return;

                // 3. Pengecekan Duplikasi Username via COUNT(*)
                string checkQuery = "SELECT COUNT(*) FROM petugas WHERE username = @username";
                using (MySqlCommand checkCmd = new MySqlCommand(checkQuery, conn))
                {
                    checkCmd.Parameters.AddWithValue("@username", txtUsername.Text.Trim());
                    int userCount = Convert.ToInt32(checkCmd.ExecuteScalar());

                    if (userCount > 0)
                    {
                        MessageBox.Show("Username sudah terdaftar! Gunakan username lain.", "Peringatan", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                        txtUsername.Focus();
                        return;
                    }
                }

                // 4. Enkripsi Data: Hash kata sandi menggunakan BCrypt
                string hashedPassword = BCrypt.Net.BCrypt.HashPassword(txtPassword.Text);

                // Insert ke database menggunakan Parameterized Query
                string insertQuery = "INSERT INTO petugas (username, password, nama_petugas, level) VALUES (@username, @password, @nama, @level)";
                using (MySqlCommand insertCmd = new MySqlCommand(insertQuery, conn))
                {
                    insertCmd.Parameters.AddWithValue("@username", txtUsername.Text.Trim());
                    insertCmd.Parameters.AddWithValue("@password", hashedPassword);
                    insertCmd.Parameters.AddWithValue("@nama", txtNamaPetugas.Text.Trim());
                    insertCmd.Parameters.AddWithValue("@level", cmbLevel.SelectedItem.ToString());

                    int rowsAffected = insertCmd.ExecuteNonQuery();
                    if (rowsAffected > 0)
                    {
                        MessageBox.Show("Petugas baru berhasil didaftarkan!", "Sukses", MessageBoxButtons.OK, MessageBoxIcon.Information);
                        this.Close();
                    }
                }
            }
        }

        private void btnBatal_Click(object sender, EventArgs e)
        {
            this.Close();
        }
    }
}


