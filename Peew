using System;
using System.Windows.Forms;
using MySql.Data.MySqlClient;
using BCrypt.Net;

namespace UKK_SPP
{
    public partial class FormLogin : Form
    {
        public FormLogin()
        {
            InitializeComponent();
            this.StartPosition = FormStartPosition.CenterScreen;
            this.AcceptButton = btnLogin; // btnLogin diset sebagai AcceptButton
            txtPassword.UseSystemPasswordChar = true;
        }

        private void btnLogin_Click(object sender, EventArgs e)
        {
            // 1. Validasi Input Kosong
            if (string.IsNullOrWhiteSpace(txtUsername.Text))
            {
                MessageBox.Show("Username tidak boleh kosong!", "Peringatan", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                txtUsername.Focus();
                return;
            }
            if (string.IsNullOrWhiteSpace(txtPassword.Text))
            {
                MessageBox.Show("Password tidak boleh kosong!", "Peringatan", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                txtPassword.Focus();
                return;
            }

            // Membuka Koneksi
            using (MySqlConnection conn = Koneksi.GetConnection())
            {
                if (conn == null) return; // Keluar jika koneksi database gagal

                // 2. Keamanan Kueri: Menggunakan Parameterized Query untuk mencegah SQL Injection
                string query = "SELECT id_petugas, username, nama_petugas, password, level FROM petugas WHERE username = @username";
                
                using (MySqlCommand cmd = new MySqlCommand(query, conn))
                {
                    cmd.Parameters.AddWithValue("@username", txtUsername.Text.Trim());

                    using (MySqlDataReader reader = cmd.ExecuteReader())
                    {
                        if (reader.Read())
                        {
                            int id = reader.GetInt32("id_petugas");
                            string username = reader.GetString("username");
                            string nama = reader.GetString("nama_petugas");
                            string dbPassword = reader.GetString("password");
                            string level = reader.GetString("level");

                            bool isPasswordValid = false;

                            // 3. Verifikasi Hash Sandi dengan Fallback Handling
                            if (dbPassword.StartsWith("$2a$") || dbPassword.StartsWith("$2y$") || dbPassword.StartsWith("$2b$"))
                            {
                                // Jika password di DB terenkripsi BCrypt
                                try
                                {
                                    isPasswordValid = BCrypt.Net.BCrypt.Verify(txtPassword.Text, dbPassword);
                                }
                                catch
                                {
                                    isPasswordValid = false;
                                }
                            }
                            else
                            {
                                // Fallback jika data seeder awal masih teks biasa (Plain Text)
                                isPasswordValid = (txtPassword.Text == dbPassword);
                            }

                            // 4. Respon Otentikasi Kesuksesan
                            if (isPasswordValid)
                            {
                                SessionUser.SetSession(id, username, nama, level);
                                
                                this.Hide();
                                FormDashboard dashboard = new FormDashboard();
                                dashboard.Show();
                            }
                            else
                            {
                                FailAuthResponse();
                            }
                        }
                        else
                        {
                            FailAuthResponse();
                        }
                    }
                }
            }
        }

        private void FailAuthResponse()
        {
            MessageBox.Show("Username tidak ditemukan atau kata sandi salah!", "Gagal Login", MessageBoxButtons.OK, MessageBoxIcon.Error);
            txtPassword.Clear();
            txtPassword.Focus();
        }

        private void btnBatal_Click(object sender, EventArgs e)
        {
            Application.Exit();
        }

        private void linkRegister_LinkClicked(object sender, LinkLabelLinkClickedEventArgs e)
        {
            FormRegisterPetugas registerForm = new FormRegisterPetugas();
            registerForm.ShowDialog();
        }
    }
}

