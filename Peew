using System;
using System.Drawing;
using System.Windows.Forms;
using MySql.Data.MySqlClient;

namespace UKK_SPP
{
    public partial class FormDashboard : Form
    {
        public FormDashboard()
        {
            InitializeComponent();
            this.StartPosition = FormStartPosition.CenterScreen;
        }

        private void FormDashboard_Load(object sender, EventArgs e)
        {
            // A.1 Proteksi Hak Akses & Session Guard
            if (!SessionUser.IsLoggedIn)
            {
                MessageBox.Show("Akses ditolak! Silakan login terlebih dahulu.", "Peringatan", MessageBoxButtons.OK, MessageBoxIcon.Stop);
                this.Close();
                Application.Exit();
                return;
            }

            // A.2 Tampilkan identitas pengguna & badge status level
            lblNamaPetugas.Text = SessionUser.NamaPetugas;
            lblLevelBadge.Text = SessionUser.Level.ToUpper();

            if (SessionUser.IsAdmin())
            {
                lblLevelBadge.ForeColor = Color.Green; // Teks hijau untuk ADMIN
                
                // A.3 RBAC: Jika pengguna adalah admin, seluruh menu aktif
                btnKelolaSiswa.Enabled = true;
                btnKelolaPetugas.Enabled = true;
                btnKelolaSPP.Enabled = true;
            }
            else
            {
                lblLevelBadge.ForeColor = Color.Orange; // Teks oranye untuk PETUGAS
                
                // A.3 RBAC: Jika pengguna petugas, nonaktifkan tombol kelola petugas & SPP
                btnKelolaSiswa.Enabled = true;
                btnKelolaPetugas.Enabled = false; // Atau set Visible = false
                btnKelolaSPP.Enabled = false;     // Atau set Visible = false
            }

            // B. Agregasi Metrik Real-Time
            LoadMetrikDashboard();
        }

        private void LoadMetrikDashboard()
        {
            using (MySqlConnection conn = Koneksi.GetConnection())
            {
                if (conn == null) return;

                try
                {
                    // Kartu 1: Total Siswa
                    string qSiswa = "SELECT COUNT(*) FROM siswa";
                    using (MySqlCommand cmd = new MySqlCommand(qSiswa, conn))
                    {
                        lblTotalSiswa.Text = cmd.ExecuteScalar().ToString();
                    }

                    // Kartu 2: Total Kelas
                    string qKelas = "SELECT COUNT(*) FROM kelas";
                    using (MySqlCommand cmd = new MySqlCommand(qKelas, conn))
                    {
                        lblTotalKelas.Text = cmd.ExecuteScalar().ToString();
                    }

                    // Kartu 3: Total Petugas
                    string qPetugas = "SELECT COUNT(*) FROM petugas";
                    using (MySqlCommand cmd = new MySqlCommand(qPetugas, conn))
                    {
                        lblTotalPetugas.Text = cmd.ExecuteScalar().ToString();
                    }

                    // Kartu 4: Penerimaan SPP Bulan Ini (Bulan dan Tahun Berjalan)
                    string qSppBulanIni = "SELECT COALESCE(SUM(jumlah_bayar), 0) FROM pembayaran WHERE bulan_dibayar = @bulan AND tahun_dibayar = @tahun";
                    using (MySqlCommand cmd = new MySqlCommand(qSppBulanIni, conn))
                    {
                        // Ambil parameter waktu secara dinamis dari sistem runtime saat ini (Tahun 2026)
                        cmd.Parameters.AddWithValue("@bulan", DateTime.Now.ToString("MMMM")); // Menghasilkan nama bulan (misal: "November")
                        cmd.Parameters.AddWithValue("@tahun", DateTime.Now.Year.ToString());

                        decimal totalBayar = Convert.ToDecimal(cmd.ExecuteScalar());
                        
                        // Format angka menjadi mata uang Rupiah (contoh: Rp 250.000)
                        lblSppBulanIni.Text = string.Format(System.Globalization.CultureInfo.GetCultureInfo("id-ID"), "Rp {0:N0}", totalBayar);
                    }
                }
                catch (Exception ex)
                {
                    MessageBox.Show("Gagal memuat beberapa statistik data real-time: " + ex.Message, "Error Metrik", MessageBoxButtons.OK, MessageBoxIcon.Error);
                }
            }
        }

        // C. Navigasi & Logout
        private void btnLogout_Click(object sender, EventArgs e)
        {
            DialogResult result = MessageBox.Show("Apakah Anda yakin ingin keluar?", "Konfirmasi Logout", MessageBoxButtons.YesNo, MessageBoxIcon.Question);
            
            if (result == DialogResult.Yes)
            {
                // Bersihkan session
                SessionUser.ClearSession();

                // Tutup dashboard dan buka kembali FormLogin
                this.Hide();
                FormLogin loginForm = new FormLogin();
                loginForm.Show();
            }
        }

        // Mengantisipasi tombol close 'X' pada pojok form agar mematikan seluruh alur background thread aplikasi
        protected override void OnFormClosing(FormClosingEventArgs e)
        {
            base.OnFormClosing(e);
            if (e.CloseReason == CloseReason.UserClosing && SessionUser.IsLoggedIn)
            {
                Application.Exit();
            }
        }
    }
}
