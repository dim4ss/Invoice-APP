
using System;
using System.Windows.Forms;
using MySql.Data.MySqlClient;

namespace UKK_SPP
{
    public static class Koneksi
    {
        private static string connectionString = "server=localhost;port=3306;database=db_spp_sekolah_xii;user=root;password=;";

        public static MySqlConnection GetConnection()
        {
            MySqlConnection conn = new MySqlConnection(connectionString);
            try
            {
                conn.Open();
                return conn;
            }
            catch (MySqlException ex)
            {
                MessageBox.Show("Gagal terhubung ke database! Pastikan server MySQL (XAMPP) sudah aktif.\n\nDetail Error: " + ex.Message, 
                                "Error Koneksi", MessageBoxButtons.OK, MessageBoxIcon.Error);
                return null;
            }
        }
    }
}


using System;

namespace UKK_SPP
{
    public static class SessionUser
    {
        public static int IdPetugas { get; private set; }
        public static string Username { get; private set; }
        public static string NamaPetugas { get; private set; }
        public static string Level { get; private set; }
        public static bool IsLoggedIn { get; private set; }

        public static void SetSession(int id, string username, string nama, string level)
        {
            IdPetugas = id;
            Username = username;
            NamaPetugas = nama;
            Level = level.ToLower();
            IsLoggedIn = true;
        }

        public static void ClearSession()
        {
            IdPetugas = 0;
            Username = null;
            NamaPetugas = null;
            Level = null;
            IsLoggedIn = false;
        }

        public static bool IsAdmin()
        {
            return Level == "admin";
        }
    }
}



